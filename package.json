{
  "name": "queue-accounting-service",
  "version": "1.0.0",
  "description": "Finite-capacity single-server queue (M/M/1/N) accounting service: analytical steady-state + discrete-event simulation, side by side.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
